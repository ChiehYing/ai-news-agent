# OpenRouter API
OPENROUTER_API_KEY=

# 可選：覆蓋 config.py 的預設模型
# PROCESSOR_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Gmail SMTP
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# 收件人（逗號分隔可多個）
EMAIL_RECIPIENTS=

# Tavily Search API（可選）
# web_search 工具預設使用 DuckDuckGo（免費、不需 key）
# DuckDuckGo 失敗時自動切換 Tavily，有設才會啟用
# 申請：https://tavily.com
TAVILY_API_KEY=

